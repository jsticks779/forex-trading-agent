# Copy this file to .env and adjust the values.

# Container timezone.
TZ=UTC

# Credentials for the KasmVNC web desktop (http://localhost:3000), used for the
# one-time MetaTrader 5 broker login. These are NOT your broker credentials.
CUSTOM_USER=admin
PASSWORD=changeme

# Note: the FastAPI service listens on a fixed port 5001 inside the container
# (hardcoded in app/main.py). Remap the host side in docker-compose.yml if needed.
